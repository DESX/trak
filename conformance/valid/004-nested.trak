# Nested objects with event lists.
root nest {
  config: {
    limits: { soft: event num, hard: event num },
    name: event str,
  },
  items: event item,
}

object item {
  label: str,
  meta: { owner: str, size: num? },
  extra: { why: |str }?,
  sub: { log: event str },
}
