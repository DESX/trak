##[ schema ]##mKcEA
# A CI server.
root ci {
  name: str,
  builds: event build,
  config: {                    # settings
    retries: event num,
  },
}

# One build.
object build {
  user: str,                   # who started it
  status: event enum(running, ok, failed),
  log: |str,
  host: { name: str, cores: num? },
  parent: path?,
}
